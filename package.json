{
  "name": "rebuild-dossier",
  "version": "0.2.4",
  "description": "MCP server that reverse-engineers a trustworthy rebuild spec from an existing app.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parker-Fawcett/rebuild-dossier.git"
  },
  "homepage": "https://github.com/Parker-Fawcett/rebuild-dossier",
  "bugs": {
    "url": "https://github.com/Parker-Fawcett/rebuild-dossier/issues"
  },
  "author": {
    "name": "Parker Fawcett",
    "email": "parker@parkerfawcett.com",
    "url": "https://www.parkerfawcett.com"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "agentic-ai",
    "developer-tools",
    "code-generation",
    "reverse-engineering",
    "spec-generation",
    "mutation-testing",
    "typescript",
    "ai-evaluation",
    "rebuild",
    "software-engineering"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "bin": {
    "rebuild-dossier": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/httpServer.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:http:prod": "node dist/httpServer.js",
    "package:mcpb": "node scripts/build-mcpb.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0-beta.5",
    "@modelcontextprotocol/node": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "express": "^4.19.0",
    "ignore": "^7.0.6",
    "playwright": "^1.61.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
